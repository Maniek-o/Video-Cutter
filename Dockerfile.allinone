# Dockerfile: All-in-one (nginx + FastAPI backend)
FROM python:3.10-slim

ENV VIDEO_CUTTER_UPLOADS_DIR=/data/source \
	VIDEO_CUTTER_CACHE_DIR=/data/temp/cache \
	VIDEO_CUTTER_OUTPUT_DIR=/data/output \
	VIDEO_CUTTER_ML_DATA_DIR=/data/temp/ml-data \
	NSFW_EXTERNAL_LOG_DIR=/data/temp/nsfw-logs \
	NSFW_MODEL_DATA_DIR=/data/nsfw-model

# --- Backend dependencies ---
WORKDIR /app
COPY ml_backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# --- Backend code ---
COPY ml_backend/ ./ml_backend/

# --- Frontend (static files) ---
RUN apt-get update && apt-get install -y nginx supervisor && rm -rf /var/lib/apt/lists/*
COPY public/ /usr/share/nginx/html/

# --- Supervisor config ---
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# --- Nginx config ---
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /data/source /data/output /data/temp/cache /data/temp/ml-data /data/temp/nsfw-logs /data/nsfw-model

VOLUME ["/data/source", "/data/output", "/data/temp", "/data/nsfw-model"]

# --- Expose ports ---
EXPOSE 5001 5003

CMD ["/usr/bin/supervisord"]